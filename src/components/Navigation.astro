---
import brandMark from '../assets/ACNminilogo.jpg';
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="#top" aria-label="Career Letter top">
      <img
        class="brand-mark"
        src={brandMark.src}
        alt="Accenture symbol"
        width={brandMark.width}
        height={brandMark.height}
        loading="eager"
        decoding="async"
      />
      <span class="brand-copy">
        <strong>Taisei Kikkawa</strong>
        <small>Career Letter</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="#overview">概要</a>
      <a href="#decision">決断</a>
      <a href="#industry">業界の見通し</a>
      <a href="#accenture">アクセンチュア</a>
      <a href="#timeline">就活の流れ</a>
      <a href="#strengths">強み</a>
      <a href="#roadmap">キャリアプラン</a>
      <a href="#lifeplan">人生設計</a>
    </nav>
  </div>
</header>
