<section class="section" id="strengths">
  <div class="section-heading reveal">
    <p class="eyebrow">Strengths</p>
    <h2>企業から評価された強み</h2>
    <p>
      技術力だけでも、コミュニケーションだけでもなく、その間をつなげられる点が、自分の武器。
    </p>
  </div>

  <div class="section-glance reveal">
    <article class="section-glance-item">
      <p class="section-glance-kicker">技術の土台</p>
      <p class="section-glance-text">AI・データ・実装経験で再現性ある提案ができる</p>
    </article>
    <article class="section-glance-item">
      <p class="section-glance-kicker">仕組み化</p>
      <p class="section-glance-text">課題を構造化し、チームが動ける形に落とし込める</p>
    </article>
    <article class="section-glance-item">
      <p class="section-glance-kicker">巻き込み力</p>
      <p class="section-glance-text">多様な関係者をつなぎ、前進させる推進力がある</p>
    </article>
  </div>

  <figure class="venn-wrap reveal" aria-label="技術の土台・仕組み化の力・人を動かす力の3つの強みが交わるソリューションエンジニアを示すベン図">
    <svg class="venn-svg" viewBox="0 0 500 390" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="vg1" cx="35%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#a855f7" stop-opacity="0.28"/>
          <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.05"/>
        </radialGradient>
        <radialGradient id="vg2" cx="65%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#6d28d9" stop-opacity="0.28"/>
          <stop offset="100%" stop-color="#4c1d95" stop-opacity="0.05"/>
        </radialGradient>
        <radialGradient id="vg3" cx="50%" cy="65%" r="65%">
          <stop offset="0%" stop-color="#c084fc" stop-opacity="0.28"/>
          <stop offset="100%" stop-color="#9333ea" stop-opacity="0.05"/>
        </radialGradient>
        <filter id="venn-center-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="10" result="blur"/>
          <feComposite in="SourceGraphic" in2="blur" operator="over"/>
        </filter>
      </defs>

      <!-- Interactive Groups -->
      <g class="venn-group cursor-pointer" data-venn="tech">
        <circle cx="165" cy="145" r="100" fill="url(#vg1)" style="mix-blend-mode: screen;"/>
        <circle cx="165" cy="145" r="100" fill="none" stroke="#8b3dff" stroke-width="1.5" stroke-opacity="0.6"/>
        <text x="100" y="126" text-anchor="middle" fill="#f0d0ff" font-size="13.5" font-weight="700" font-family="'Outfit','Noto Sans JP',sans-serif">技術の土台</text>
        <text x="100" y="143" text-anchor="middle" fill="#7a6a96" font-size="10.5" font-family="'Outfit','Noto Sans JP',sans-serif">AI・実装・研究</text>
      </g>

      <g class="venn-group cursor-pointer" data-venn="system">
        <circle cx="335" cy="145" r="100" fill="url(#vg2)" style="mix-blend-mode: screen;"/>
        <circle cx="335" cy="145" r="100" fill="none" stroke="#6d28d9" stroke-width="1.5" stroke-opacity="0.6"/>
        <text x="400" y="126" text-anchor="middle" fill="#d8c8ff" font-size="13.5" font-weight="700" font-family="'Outfit','Noto Sans JP',sans-serif">仕組み化の力</text>
        <text x="400" y="143" text-anchor="middle" fill="#7a6a96" font-size="10.5" font-family="'Outfit','Noto Sans JP',sans-serif">構造化・翻訳</text>
      </g>

      <g class="venn-group cursor-pointer" data-venn="people">
        <circle cx="250" cy="273" r="100" fill="url(#vg3)" style="mix-blend-mode: screen;"/>
        <circle cx="250" cy="273" r="100" fill="none" stroke="#c084fc" stroke-width="1.5" stroke-opacity="0.55"/>
        <text x="250" y="336" text-anchor="middle" fill="#e8c0ff" font-size="13.5" font-weight="700" font-family="'Outfit','Noto Sans JP',sans-serif">人を動かす力</text>
        <text x="250" y="353" text-anchor="middle" fill="#7a6a96" font-size="10.5" font-family="'Outfit','Noto Sans JP',sans-serif">推進・巻き込み</text>
      </g>

      <!-- Center glow -->
      <g class="venn-center-group">
        <circle cx="250" cy="188" r="36" fill="rgba(161,0,255,0.38)" filter="url(#venn-center-glow)" opacity="0.55"/>
        <circle cx="250" cy="188" r="30" fill="rgba(139,61,255,0.28)" stroke="rgba(214,164,255,0.55)" stroke-width="1"/>
        <text x="250" y="184" text-anchor="middle" fill="#ffffff" font-size="11.5" font-weight="800" font-family="'Outfit',sans-serif" letter-spacing="0.05em">Solution</text>
        <text x="250" y="200" text-anchor="middle" fill="#ffffff" font-size="11.5" font-weight="800" font-family="'Outfit',sans-serif" letter-spacing="0.05em">Engineer</text>
      </g>
    </svg>
    </svg>
    <figcaption class="venn-caption">円をタップして詳細を確認してください</figcaption>
  </figure>

  <div class="strength-grid">
    <article class="strength-card reveal" data-card="tech">
      <h3>技術の土台</h3>
      <ul>
        <li>AI・データサイエンス・将棋AI研究</li>
        <li>Python / PyTorch / LightGBM / C++ / Web開発</li>
        <li>研究だけでなく、インターンや開発での実装経験</li>
      </ul>
    </article>

    <article class="strength-card reveal" data-card="system">
      <h3>仕組み化の力</h3>
      <ul>
        <li>業務改善やDXに関わるインターン経験</li>
        <li>チームが動きやすくなる構造を考えるのが得意</li>
        <li>技術をビジネス価値に翻訳できる</li>
      </ul>
    </article>

    <article class="strength-card reveal" data-card="people">
      <h3>人を動かす力</h3>
      <ul>
        <li>200人規模イベントの主催・推進</li>
        <li>外部折衝や窓口業務の経験</li>
        <li>多様な立場の人を巻き込むコミュニケーション力</li>
      </ul>
    </article>
  </div>
</section>

<style>
  .cursor-pointer {
    cursor: pointer;
  }
  .venn-center-group {
    pointer-events: none; /* 中央ラベルはクリックをブロックしない */
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener('DOMContentLoaded', () => {
    const groups = document.querySelectorAll('.venn-group');
    const cards = document.querySelectorAll('.strength-card');

    const vennData: Record<string, { cx: number; cy: number }> = {
      tech: { cx: 165, cy: 145 },
      system: { cx: 335, cy: 145 },
      people: { cx: 250, cy: 273 }
    };

    let activeId: string | null = null;

    groups.forEach(group => {
      // ホバー効果
      group.addEventListener('mouseenter', () => {
        const id = group.getAttribute('data-venn');
        if (id && activeId !== id) {
          gsap.to(group, { scale: 1.02, opacity: 0.8, duration: 0.2, transformOrigin: `${vennData[id].cx}px ${vennData[id].cy}px` });
        }
      });
      group.addEventListener('mouseleave', () => {
        const id = group.getAttribute('data-venn');
        if (id && activeId !== id) {
          gsap.to(group, { scale: 1, opacity: activeId ? 0.4 : 1, duration: 0.2, transformOrigin: `${vennData[id].cx}px ${vennData[id].cy}px` });
        }
      });

      // クリックイベント
      group.addEventListener('click', () => {
        const id = group.getAttribute('data-venn');
        if (!id || activeId === id) return;

        // 他の円を少し薄める
        groups.forEach(g => {
          if (g !== group) {
            const gid = g.getAttribute('data-venn');
            if (gid) {
              gsap.to(g, { opacity: 0.4, scale: 1, duration: 0.3, transformOrigin: `${vennData[gid].cx}px ${vennData[gid].cy}px` });
            }
          }
        });

        // クリックした円をハイライト・拡大
        gsap.to(group, { opacity: 1, scale: 1.05, duration: 0.4, ease: "back.out(1.5)", transformOrigin: `${vennData[id].cx}px ${vennData[id].cy}px` });

        // 下のカードをハイライト
        cards.forEach(card => {
          const cardId = card.getAttribute('data-card');
          if (cardId === id) {
            // 対象のカードを強調
            gsap.to(card, {
              opacity: 1,
              scale: 1.02,
              boxShadow: "0 8px 32px rgba(161,0,255,0.25)",
              borderColor: "rgba(161,0,255,0.5)",
              duration: 0.4,
              ease: "power2.out"
            });
          } else {
            // 他のカードを薄くする
            gsap.to(card, {
              opacity: 0.4,
              scale: 0.98,
              boxShadow: "none",
              borderColor: "rgba(255,255,255,0.1)",
              duration: 0.4,
              ease: "power2.out"
            });
          }
        });

        activeId = id;
      });
    });
  });
</script>
